rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /categories/{document} { allow read: if true; allow write: if false; }
    match /topics/{document} { allow read: if true; allow write: if false; }
    match /items/{document} { allow read: if true; allow write: if false; }

    // User progress and notes
    match /user_progress/{userId}/categories/{categoryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /notes/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}